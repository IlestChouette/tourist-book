# Tourist Book: variables de entorno.
# Este archivo solo tiene los NOMBRES, sin valores reales. Copiarlo como `.env.local`
# (desarrollo) o cargarlas en el panel del hosting (producción) y rellenar los valores.
# Los valores reales NUNCA se suben a GitHub: `.env*` está en .gitignore.
#
# Las que empiezan por NEXT_PUBLIC_ viajan al navegador (son públicas por diseño).
# Las demás son secretas y solo las usa el servidor.

# --- Supabase (base de datos, autenticación y almacenamiento de archivos) ---
# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon) de Supabase: la usa el navegador y el middleware de sesión.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service role): acceso total a la base de datos, solo servidor.
# También firma los códigos PIN y los enlaces firmados (si cambia, esos códigos dejan de valer).
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
# Dirección pública del sitio, usada en enlaces de emails y de Stripe. Opcional:
# si falta, usa https://tourist-book.com
SITE_URL=

# --- Tareas programadas (cron) ---
# Secreto que deben enviar las tareas programadas en la cabecera "Authorization: Bearer ...".
# Debe ser el mismo valor que está en el trabajo programado de Supabase (relevo de hoteles)
# y en las tareas diarias del hosting.
CRON_SECRET=

# --- Correo (Resend) ---
# Clave de Resend para enviar emails (avisos, relevos del cahier, recordatorios).
RESEND_API_KEY=

# --- Pagos (Stripe) ---
# Clave secreta de Stripe (sk_live_... en producción).
STRIPE_SECRET_KEY=
# Secreto de firma del webhook de Stripe (whsec_...). Sale al crear el endpoint
# https://TU-DOMINIO/api/webhooks/stripe en el panel de Stripe.
STRIPE_WEBHOOK_SECRET=
# Identificadores de precio (price_...) de los planes del livret.
STRIPE_PRICE_BASICO_ANUAL=
STRIPE_PRICE_BASICO_TEMPORADA=
STRIPE_PRICE_PREMIUM_ANUAL=
STRIPE_PRICE_PREMIUM_TEMPORADA=
# Clave pública de Stripe: hoy el código no la usa, pero existe en el entorno.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# (El precio del cahier de hoteles, 15 EUR por servicio, no lleva variable: el código lo crea
# solo en Stripe la primera vez, buscándolo por la clave "tb_hotel_cahier_service_monthly".)

# --- Inteligencia artificial (Anthropic) ---
# Asistente del livret Premium y traducción automática. Si falta, el asistente responde
# por palabras clave y no se traduce.
ANTHROPIC_API_KEY=

# --- Analítica ---
# ID de medida de Google Analytics (G-XXXXXXX). Solo se carga si el visitante acepta las cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- WhatsApp Cloud API (avisos de traslados). Opcional: si faltan, no se envía nada ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada en Meta. Opcional (por defecto: nouvelle_demande_transfert).
WHATSAPP_TEMPLATE_NAME=
# Números que reciben el aviso, en formato internacional y separados por comas.
WHATSAPP_TRANSPORT_NUMBERS=
