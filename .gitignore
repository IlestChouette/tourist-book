# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ... sauf le modèle sans valeurs : il liste seulement les NOMS des variables
!.env.example

# vercel
.vercel

# claude code (local/secret only; settings.json and skills/ stay committed)
.claude/settings.local.json
.claude/*.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# cache local du CLI Supabase et copies accidentelles « nom 2.ext »
supabase/.temp/
* 2.*
